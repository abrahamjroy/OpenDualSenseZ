# OpenDSZ - Sony DualSense & DualSense Edge Controller udev Rules
# Allows non-root access to DualSense HID raw interfaces for adaptive triggers, haptics, and lightbar

# DualSense Wireless Controller (USB & Bluetooth)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0666", TAG+="uaccess"

# DualSense Edge Wireless Controller (USB & Bluetooth)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0666", TAG+="uaccess"
